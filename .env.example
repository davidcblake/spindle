# Supabase (Settings → API in your Supabase project)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Anthropic (console.anthropic.com — use a dedicated key for Spindle)
# SERVER ONLY — never expose with NEXT_PUBLIC_
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which model prepares studies and plans (decision 0005).
# ANTHROPIC_MODEL sets both; the SPINDLE_ ones override it per task.
# ANTHROPIC_MODEL=claude-sonnet-5
# SPINDLE_STUDY_MODEL=claude-haiku-5-5
# SPINDLE_PLAN_MODEL=claude-sonnet-5
# SPINDLE_STEP_UP_MODEL=claude-sonnet-5-5
# SPINDLE_STUDY_EFFORT=medium   # low | medium | high | xhigh | max
# SPINDLE_PLAN_EFFORT=medium

# The native iPhone app's routes (/api/app/*) — SETUP.md §6. SERVER ONLY.
# APP_SERVER_SECRET=long-random-secret-also-hashed-into-app_server_secret
# APPLE_TEAM_ID=ABCDE12345

# Push alerts to Dave's phone through ntfy.sh (decision 0006, SETUP.md §7). SERVER ONLY.
# The topic name is the only key: long and random. Unset = no alerts.
# NTFY_TOPIC=spindle-long-random-name
