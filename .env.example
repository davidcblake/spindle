# Supabase (Settings → API in your Supabase project)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Anthropic (console.anthropic.com — use a dedicated key for Spindle)
# SERVER ONLY — never expose with NEXT_PUBLIC_
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the study model (defaults to claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5
